classDiagram
    direction TB

    class ContentView {
        <<struct>>
        原有分頁內容
        preventAutoClose
    }
    class BoringHeader {
        <<struct>>
        showDeviceBatteries
        Settings 左側顯示 AirPods
    }
    class DeviceBatteryIndicator {
        <<struct>>
        devices
        selectedID
        showPopover
    }
    class DeviceBatteryPopover {
        <<struct>>
        device
        顯示各部件與資料狀態
    }
    class BoringViewModel {
        <<class>>
        notchSize
        isDeviceBatteryPopoverActive
    }
    class AppDelegate {
        <<class>>
        applicationDidFinishLaunching()
        applicationWillTerminate()
        更新設定與睡眠狀態
    }
    class DeviceBatteryManager {
        <<class>>
        devices
        sourceStates
        startBackgroundUpdates()
        stopBackgroundUpdates()
        refreshIfNeeded()
    }
    class DeviceBatterySnapshot {
        <<struct>>
        id
        name
        kind
        connectionState
        components
        compactReading
    }
    class BatteryComponentReading {
        <<struct>>
        component
        percent
        chargingState
        readAt
        sourceUpdatedAt
        provenance
    }
    class XPCHelperClient {
        <<class>>
        fetchDeviceBatteries(request)
        cancelDeviceBatteryRequest(id)
    }
    class BoringNotchXPCHelper {
        <<class>>
        fetchDeviceBatteries(request, reply)
        cancelDeviceBatteryRequest(id)
    }
    class DeviceBatteryProbe {
        <<actor>>
        fetch(request)
        cancel(id)
        合併查詢與取消工作
    }
    class AirPodsBatteryReader {
        <<struct>>
        read()
        parseSystemReport(data)
    }


    ContentView --> BoringHeader : 展開時顯示
    BoringHeader --> DeviceBatteryIndicator : Settings 左側
    ContentView --> BoringViewModel : 開合與阻止自動收合
    DeviceBatteryIndicator --> DeviceBatteryPopover : 點擊裝置
    DeviceBatteryIndicator --> DeviceBatteryManager : 觀察共用狀態
    DeviceBatteryIndicator --> BoringViewModel : 管理本視窗 popover
    DeviceBatteryPopover --> DeviceBatterySnapshot : 唯讀呈現
    AppDelegate --> DeviceBatteryManager : 啟停與睡眠喚醒
    DeviceBatteryManager --> XPCHelperClient : 注入非同步讀取操作
    DeviceBatteryManager "1" o-- "0..*" DeviceBatterySnapshot : 發布與判斷過期
    DeviceBatterySnapshot "1" *-- "0..*" BatteryComponentReading : 各部件獨立電量
    XPCHelperClient ..> BoringNotchXPCHelper : 既有 XPC protocol 新增方法
    BoringNotchXPCHelper --> DeviceBatteryProbe : 呼叫共用 actor
    DeviceBatteryProbe --> AirPodsBatteryReader : 系統藍牙報告
    AirPodsBatteryReader ..> DeviceBatterySnapshot : 產生

